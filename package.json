{
  "name": "workbase-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubknejzlik/workbase-sdk.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/core",
    "packages/plugins",
    "packages/mcp",
    "packages/frontend-console",
    "packages/console-generated",
    "packages/ui",
    "packages/test-support"
  ],
  "scripts": {
    "lint": "bun scripts/sdk-lint.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ui && tsc --noEmit -p packages/frontend-console",
    "test": "vitest run && vitest run --config packages/plugins/console/ui/vitest.config.ts && vitest run --config vitest.infra.config.ts && vitest run --config vitest.tools.config.ts && bun test scripts/sdk-provenance.test.ts scripts/lib/sdk-workspaces.test.ts && bun run --cwd packages/ui test && bun run --cwd packages/frontend-console test",
    "test:mcp": "vitest run --config packages/mcp/vitest.config.ts",
    "migrate:plan": "bun scripts/schema.ts plan",
    "check:schema": "bun scripts/schema.ts check",
    "check:access": "bun scripts/check-access.ts",
    "access:lock": "bun scripts/check-access.ts --write",
    "check:ci-invariants": "bun scripts/sdk-ci-invariants.ts && bun run check:ui",
    "console:build": "bun scripts/build-console.ts",
    "sdk:pack": "bash scripts/sdk-pack.sh",
    "check:ui": "bun packages/plugins/console/ui/src/cli.ts",
    "check:openapi": "bun scripts/check-openapi.ts",
    "openapi:write": "bun scripts/check-openapi.ts --write"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@playwright/test": "1.58.2",
    "@pulumi/command": "1.2.1",
    "@types/node": "^25.0.0",
    "@workbasehq/core": "workspace:*",
    "@workbasehq/plugins": "workspace:*",
    "playwright": "1.58.2",
    "sst": "4.17.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0",
    "wrangler": "4.126.0"
  },
  "patchedDependencies": {
    "sonner@2.0.7": "patches/sonner@2.0.7.patch",
    "@radix-ui/react-select@2.2.6": "patches/@radix-ui%2Freact-select@2.2.6.patch",
    "wrangler@4.126.0": "patches/wrangler@4.126.0.patch"
  }
}
