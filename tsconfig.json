{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "packages/core/**/*.ts",
    "packages/plugins/**/*.ts",
    "packages/mcp/src/**/*.ts",
    "packages/mcp/test/**/*.ts",
    "packages/test-support/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**"
  ]
}
