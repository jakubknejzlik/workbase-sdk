{
  "mcpServers": {
    "workbase_data": {
      "command": "bun",
      "args": [
        "./node_modules/@workbasehq/mcp/src/bin.ts",
        "data"
      ],
      "env": {
        "WORKBASE_BASE_URL": "${WORKBASE_BASE_URL}",
        "WORKBASE_TOKEN": "${WORKBASE_TOKEN}",
        "WORKBASE_ORG_ID": "${WORKBASE_ORG_ID}",
        "WORKBASE_READ_ONLY": "true"
      }
    },
    "workbase_ops": {
      "command": "bun",
      "args": [
        "./node_modules/@workbasehq/mcp/src/bin.ts",
        "ops"
      ],
      "env": {
        "WORKBASE_BASE_URL": "${WORKBASE_BASE_URL}",
        "WORKBASE_OPS_TOKEN": "${WORKBASE_OPS_TOKEN}",
        "WORKBASE_DEV_MAILBOX_URL": "${WORKBASE_DEV_MAILBOX_URL:-}",
        "WORKBASE_DEV_MAILBOX_TOKEN": "${WORKBASE_DEV_MAILBOX_TOKEN:-}"
      }
    }
  }
}
