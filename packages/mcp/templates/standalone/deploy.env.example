# Copy to .env; keep credentials private. SST loads .env automatically.
CLOUDFLARE_DEFAULT_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BETTER_AUTH_SECRET=
WORKBASE_RESOURCE_PREFIX=
# Set this literal bare hostname to derive the HTTPS origin and attach a Cloudflare
# Custom Domain (SDK manages DNS/certificate). No scheme, port, path or {stage}.
# A set value must be a valid lowercase ASCII hostname using only [a-z0-9.-],
# validated without normalization. Only an unset variable means no public hostname.
# Empty or whitespace-only set values fail fast, even with a valid AUTH_BASE_URL.
# Uncomment and set a hostname, or leave this variable unset to use the fallback.
# WORKBASE_PUBLIC_HOSTNAME=app.example.test
# Optional HTTPS origin fallback without a custom hostname, e.g. workers.dev.
# Required only when WORKBASE_PUBLIC_HOSTNAME is unset; blank AUTH_BASE_URL is unset.
# Only this fallback expands {stage}, e.g. https://worker-{stage}.account.workers.dev.
# If both are set, the hostname wins; a different/invalid fallback emits one warning.
AUTH_BASE_URL=
# Required operator secret for organization provisioning; separate from auth/mailbox secrets.
WORKBASE_OPS_TOKEN=
# Sender authorized by Cloudflare Email Routing/send_email. Required unless using
# the dev mailbox below. Never combine EMAIL_FROM with WORKBASE_DEV_MAILBOX_TOKEN.
EMAIL_FROM=
# Optional mailbox secret (32–256 printable ASCII characters, no whitespace).
# Only exact dev/test stages; leave EMAIL_FROM empty. Keep all three secrets distinct.
WORKBASE_DEV_MAILBOX_TOKEN=
# After deployment, copy devMailboxUrl here for the ops MCP server (not an SST input).
WORKBASE_DEV_MAILBOX_URL=
# Separately launched MCP clients must set this to the resolved origin themselves.
# Deploy env is not inherited: resolve WORKBASE_PUBLIC_HOSTNAME as HTTPS or use the expanded fallback.
WORKBASE_BASE_URL=
# Preview CI stage prefix; prefix-pr-N must fit 32 characters.
WORKBASE_STAGE_PREFIX=
# Operator login address, used manually in the browser (never a seeded identity).
WORKBASE_OWNER_EMAIL=
