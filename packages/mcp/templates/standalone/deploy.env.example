# Copy to .env; keep credentials private. SST loads .env automatically.
CLOUDFLARE_DEFAULT_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BETTER_AUTH_SECRET=
WORKBASE_RESOURCE_PREFIX=
# Exact public HTTPS origin; {stage} is expanded by sst.config.ts.
AUTH_BASE_URL=
# Optional custom hostname, matching AUTH_BASE_URL (no scheme/path).
WORKBASE_DOMAIN=
# Sender authorized by Cloudflare Email Routing/send_email.
EMAIL_FROM=
# Preview CI stage prefix; prefix-pr-N must fit 32 characters.
WORKBASE_STAGE_PREFIX=
# Operator login address, used manually in the browser (never a seeded identity).
WORKBASE_OWNER_EMAIL=
