{
  "name": "workbase-{{INSTANCE_SELECTOR}}",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun scripts/typecheck.ts",
    "migrate:initial": "bun scripts/initial-migrations.ts",
    "migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to .wrangler/state",
    "migrate:plugins": "bun scripts/migrate-plugins.ts",
    "check:migrations": "bun scripts/check-migrations.ts",
    "migrate:remote": "workbase-migrate migrate \"$DATABASE_ID\" ./migrations --config ./config.ts",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 9290 --inspector-port 9291 --persist-to .wrangler/state",
    "deploy": "sst deploy",
    "remove": "sst remove"
  },
  "dependencies": {
    "@workbasehq/core": "{{SDK_VERSION}}",
    "@workbasehq/mcp": "{{SDK_VERSION}}",
    "@workbasehq/plugins": "{{SDK_VERSION}}"
  },
  "devDependencies": {
    "wrangler": "4.126.0",
    "typescript": "5.7.2",
    "@types/node": "^25.0.0",
    "@cloudflare/workers-types": "^5.0.0",
    "sst": "4.17.1",
    "@pulumi/command": "1.2.1",
    "@pulumi/pulumi": "3.215.0",
    "tsx": "4.23.15"
  },
  "packageManager": "bun@1.4.3"
}
