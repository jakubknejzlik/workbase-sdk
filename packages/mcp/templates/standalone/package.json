{
  "name": "workbase-{{INSTANCE_SELECTOR}}",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate:plan": "bun node_modules/@workbasehq/core/src/migrations/schema-cli.ts plan",
    "check:schema": "bun node_modules/@workbasehq/core/src/migrations/schema-cli.ts check",
    "access:lock": "bun node_modules/@workbasehq/core/src/access-lock/cli.ts --config runtime.ts --write",
    "check:access": "bun node_modules/@workbasehq/core/src/access-lock/cli.ts --config runtime.ts",
    "openapi:write": "bun node_modules/@workbasehq/core/src/openapi/cli.ts --write",
    "check:openapi": "bun node_modules/@workbasehq/core/src/openapi/cli.ts",
    "check:ui": "bun scripts/check-ui.ts",
    "check": "bun run check:schema && bun run check:access && bun run check:openapi && bun run check:ui",
    "generate:ui": "bun scripts/generate-ui.ts",
    "typecheck": "bun run generate:ui && bun scripts/typecheck.ts",
    "build:console": "bun --bun vite build",
    "dev": "bun --bun vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --local --ip 127.0.0.1 --port 9290 --inspector-port 9291 --persist-to .wrangler/state",
    "migrate:remote": "workbase-migrate migrate \"$DATABASE_ID\" ./migrations --config ./runtime.ts",
    "deploy": "bun run check && bun run build:console && sst deploy",
    "remove": "sst remove"
  },
  "dependencies": {
    "@workbasehq/core": "{{SDK_VERSION}}",
    "@workbasehq/mcp": "{{SDK_VERSION}}",
    "@workbasehq/plugins": "{{SDK_VERSION}}",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.170.41",
    "i18next": "25.10.10"
  },
  "devDependencies": {
    "wrangler": "4.126.0",
    "typescript": "6.0.3",
    "@types/node": "^25.0.0",
    "@cloudflare/workers-types": "^5.0.0",
    "sst": "4.17.1",
    "@pulumi/command": "1.2.1",
    "@pulumi/pulumi": "3.246.0",
    "tsx": "4.23.15",
    "vite": "7.3.1",
    "@tanstack/router-generator": "1.146.2",
    "es-module-lexer": "2.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  },
  "packageManager": "bun@1.4.3"
}
